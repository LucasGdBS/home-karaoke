{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karaoke Home",
  "version": "0.1.2",
  "identifier": "com.homekaraoke.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Karaoke Home",
        "width": 1280,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "publisher": "LucasGdBS",
    "copyright": "© LucasGdBS",
    "homepage": "https://github.com/LucasGdBS/home-karaoke",
    "category": "Music",
    "shortDescription": "Karaoke offline para festas em casa",
    "longDescription": "Busque músicas no YouTube, baixe com letra sincronizada e cante com a voz original removida por IA. Tudo roda no seu computador, sem internet na hora de cantar.",
    "externalBin": ["binaries/ffmpeg"],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-libav", "gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
